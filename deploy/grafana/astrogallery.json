        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "User agents hitting the origin most",
      "id": 13,
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_ASTRO}"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "table",
          "query": "SELECT \"ua\", \"uri\", \"status\", \"country\" FROM \"access\" WHERE \"lan\" = '0' AND $timeFilter ORDER BY time DESC LIMIT 300"
        }
      ],
      "transformations": [
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "ua": {
                "aggregations": [],
                "operation": "groupby"
              },
              "uri": {
                "aggregations": [
                  "count"
                ],
                "operation": "aggregate"
              }
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "uri (count)",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
