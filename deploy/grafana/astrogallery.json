    {
      "type": "timeseries",
      "title": "Page views per hour",
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_ASTRO}"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "target pages",
          "query": "SELECT count(\"bytes\") FROM \"access\" WHERE \"lan\" = '0' AND (\"status\" = '200' OR \"status\" = '304') AND \"kind\" = 'page' AND $timeFilter GROUP BY time(1h) fill(0)"
        },
        {
          "refId": "B",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "gallery index",
          "query": "SELECT count(\"bytes\") FROM \"access\" WHERE \"lan\" = '0' AND (\"status\" = '200' OR \"status\" = '304') AND \"kind\" = 'index' AND $timeFilter GROUP BY time(1h) fill(0)"
        },
        {
          "refId": "C",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "full-res downloads",
          "query": "SELECT count(\"bytes\") FROM \"access\" WHERE \"lan\" = '0' AND \"status\" = '200' AND \"kind\" = 'full' AND $timeFilter GROUP BY time(1h) fill(0)"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "lineWidth": 0
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Views by country",
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_ASTRO}"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "table",
          "query": "SELECT count(\"bytes\") AS \"views\" FROM \"access\" WHERE \"lan\" = '0' AND (\"status\" = '200' OR \"status\" = '304') AND (\"kind\" = 'page' OR \"kind\" = 'index') AND $timeFilter GROUP BY \"country\""
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {},
            "renameByName": {}
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "views",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "views"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              }
            ]
          }
        ]
      }
    },
