        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_ASTRO}"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT count(\"bytes\") FROM \"access\" WHERE \"lan\" = '0' AND \"status\" <> '200' AND \"status\" <> '304' AND \"status\" <> '206' AND $timeFilter"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
