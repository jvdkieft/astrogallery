    {
      "type": "table",
      "title": "Where visitors came from (external referrers, newest first)",
      "id": 11,
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 16,
        "y": 13
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_ASTRO}"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "table",
          "query": "SELECT \"referer\", \"page\", \"country\" FROM \"access\" WHERE \"lan\" = '0' AND (\"status\" = '200' OR \"status\" = '304') AND (\"kind\" = 'page' OR \"kind\" = 'index') AND \"referer\" <> '' AND \"referer\" !~ /bortle9\\.space/ AND $timeFilter ORDER BY time DESC LIMIT 200"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          }
        ]
      }
    },
    {
