          "query": "SELECT count(\"bytes\") AS \"views\" FROM \"access\" WHERE \"lan\" = '0' AND (\"status\" = '200' OR \"status\" = '304') AND \"kind\" = 'page' AND $timeFilter GROUP BY \"page\""
        }
