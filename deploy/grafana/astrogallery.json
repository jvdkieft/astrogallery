  "title": "bortle9.space traffic",
  "uid": "bortle9-traffic",
  "description": "Visitors of the astro gallery: origin access log (pages, downloads, countries, referrers; LAN excluded) and Cloudflare edge totals (incl. cached images).",
  "tags": [
    "astrogallery",
    "web"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "5m",
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Visitors (origin access log, home network excluded)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "panels": []
