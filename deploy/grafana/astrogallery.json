      "datasource": {
        "type": "influxdb",
        "uid": "${DS_ASTRO}"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT count(\"bytes\") FROM \"access\" WHERE \"lan\" = '0' AND (\"status\" = '200' OR \"status\" = '304') AND (\"kind\" = 'page' OR \"kind\" = 'index') AND $timeFilter"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0"
        },
        "overrides": []
      }
    },
