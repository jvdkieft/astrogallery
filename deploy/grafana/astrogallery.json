        "w": 4,
        "x": 20,
        "y": 1
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_ASTRO}"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT count(\"bytes\") FROM \"access\" WHERE \"lan\" = '1' AND (\"kind\" = 'page' OR \"kind\" = 'index') AND $timeFilter"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
